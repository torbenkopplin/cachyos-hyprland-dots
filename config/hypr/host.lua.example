------------------------------------------------------------------------------
-- Workspace bands
------------------------------------------------------------------------------
--
-- One entry per monitor. `base` must be the monitor's id x WORKSPACE_BAND (10),
-- so monitor 0 owns workspaces 1-10, monitor 1 owns 11-20, and so on.
--
-- `direction` is the scrolling layout's own axis for that band -- which is the
-- point of doing it per monitor. A portrait screen is far more usable scrolling
-- down than sideways.
--
-- `column_width` is the default fraction of the monitor a new column takes.
-- A portrait monitor wants 1.0 (one column fills the width); a wide landscape
-- one wants a third. Hyprland has no per-monitor form of this option, so
-- lib/colwidth.lua applies it as focus moves between monitors -- which is why
-- this is a real per-band setting and not decoration. A band that omits it gets
-- COLUMN_WIDTH from conf/options.lua.

-- WSBANDS = {
--     { base =  0, monitor = "DP-3",     direction = "right", column_width = 0.333 },
--     { base = 10, monitor = "HDMI-A-1", direction = "down",  column_width = 1.0   },
-- }

