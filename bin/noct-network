#!/usr/bin/env bash
# noct-network -- NetworkManager picker for the Noctalia launcher.
#
#   noct-network list           emit launcher candidates
#   noct-network act "<line>"   connect / disconnect / toggle radio
#
# Ordering is deliberate: what you can turn OFF comes first (you usually open
# this to disconnect from something), then saved profiles, then what is in
# the air.

set -uo pipefail

. "$(dirname "$(readlink -f "$0")")/noct-common.sh"

usage() { echo "usage: $0 list | $0 act <line>" >&2; exit 2; }

# nmcli escapes a literal ':' as '\:' even in --get-values output.
unescape() { sed 's/\\:/:/g'; }

# ---------------------------------------------------------------------------

list() {
    provider network
    begin_list
    need nmcli || return 0

    local active saved wifi_enabled
    active=$(nmcli -g NAME connection show --active 2>/dev/null | unescape)
    saved=$(nmcli -g NAME connection show 2>/dev/null | unescape)
    wifi_enabled=$(nmcli radio wifi 2>/dev/null)

    # --- currently connected -------------------------------------------------
    while IFS= read -r name; do
        [[ -z $name ]] && continue
        item "● Disconnect  $name" "connected" "down:$name"
    done <<<"$active"

    # --- saved but not connected --------------------------------------------
    while IFS= read -r name; do
        [[ -z $name ]] && continue
        grep -qxF "$name" <<<"$active" && continue
        item "Connect  $name" "saved profile" "up:$name"
    done <<<"$saved"

    # --- in range ------------------------------------------------------------
    if [[ $wifi_enabled == enabled ]]; then
        # Three single-field queries rather than one multi-field query: nmcli
        # only escapes its separator, and asking for one field at a time
        # sidesteps that entirely. The rows line up.
        local ssids signals security seen=""
        ssids=$(nmcli -g SSID device wifi list 2>/dev/null | unescape)
        signals=$(nmcli -g SIGNAL device wifi list 2>/dev/null)
        security=$(nmcli -g SECURITY device wifi list 2>/dev/null | unescape)

        while IFS=$'\x1f' read -r ssid signal sec; do
            [[ -z $ssid ]] && continue                  # hidden network
            grep -qxF "$ssid" <<<"$saved" && continue   # already offered above
            grep -qxF "$ssid" <<<"$seen" && continue    # same AP, several bands
            seen+="$ssid"$'\n'

            item "$ssid" "${signal}%${sec:+ · $sec}" "wifi:$ssid"
        done < <(paste -d$'\x1f' <(echo "$ssids") <(echo "$signals") <(echo "$security"))

        item "Turn Wi-Fi off" "" "radio:off"
    else
        item "Turn Wi-Fi on" "the radio is off" "radio:on"
    fi
}

# ---------------------------------------------------------------------------

act() {
    provider network

    local data action arg
    data=$(payload "$1")
    [[ -z $data ]] && exit 0

    action=${data%%:*}
    arg=${data#*:}

    case "$action" in
        up)
            nmcli connection up "$arg" >/dev/null 2>&1 \
                || notify-send -a Network -u critical "Could not connect" "$arg" 2>/dev/null
            ;;
        down)
            nmcli connection down "$arg" >/dev/null 2>&1
            ;;
        wifi)
            # Try the open / already-known case first. If NetworkManager wants
            # a passphrase we cannot prompt here -- exec runs detached with no
            # tty -- so hand it to nmcli --ask in a terminal, which reads the
            # secret without echoing it.
            if ! nmcli device wifi connect "$arg" >/dev/null 2>&1; then
                in_terminal nmcli --ask device wifi connect "$arg"
            fi
            ;;
        radio)
            if [[ $arg == on ]]; then
                noctalia msg wifi-enable >/dev/null 2>&1
            else
                noctalia msg wifi-disable >/dev/null 2>&1
            fi
            ;;
    esac
}

# ---------------------------------------------------------------------------

case "${1:-}" in
    list) list ;;
    act)  [[ $# -ge 2 ]] || usage; act "$2" ;;
    *)    usage ;;
esac
