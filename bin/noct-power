#!/usr/bin/env bash
# noct-power -- power profile and screen-comfort toggles for the launcher.
#
#   noct-power list           emit launcher candidates
#   noct-power act "<line>"   apply the chosen setting
#
# Profiles come from power-profiles-daemon via UPower, the same source
# Noctalia's own power widget uses, so the two never disagree.

set -uo pipefail

. "$(dirname "$(readlink -f "$0")")/noct-common.sh"

usage() { echo "usage: $0 list | $0 act <line>" >&2; exit 2; }

# ---------------------------------------------------------------------------

list() {
    provider power
    begin_list

    if command -v powerprofilesctl >/dev/null 2>&1; then
        local active
        active=$(powerprofilesctl get 2>/dev/null)

        # `powerprofilesctl list` marks the active profile with '*' and prints
        # each name indented as "  name:".
        while IFS= read -r profile; do
            [[ -z $profile ]] && continue
            if [[ $profile == "$active" ]]; then
                item "● Power: $profile" "active" "profile:$profile"
            else
                item "Power: $profile" "" "profile:$profile"
            fi
        done < <(powerprofilesctl list 2>/dev/null |
                 awk '/^[[:space:]]*\*?[[:space:]]*[a-z-]+:/ { gsub(/[ *:]/, ""); print }')
    else
        item "power-profiles-daemon is not installed" "no power profiles available" ""
    fi

    item "Night light: toggle schedule" "" "night:schedule"
    item "Night light: force on / off"  "ignore the schedule" "night:force"
    item "Caffeine"                     "keep the screen awake" "caffeine:toggle"
}

# ---------------------------------------------------------------------------

act() {
    provider power

    local data action arg
    data=$(payload "$1")
    [[ -z $data ]] && exit 0

    action=${data%%:*}
    arg=${data#*:}

    case "$action" in
        profile)  noctalia msg power-set "$arg" >/dev/null 2>&1 ;;
        caffeine) noctalia msg caffeine-toggle  >/dev/null 2>&1 ;;
        night)
            if [[ $arg == force ]]; then
                noctalia msg nightlight-force-toggle >/dev/null 2>&1
            else
                noctalia msg nightlight-toggle >/dev/null 2>&1
            fi
            ;;
    esac
}

# ---------------------------------------------------------------------------

case "${1:-}" in
    list) list ;;
    act)  [[ $# -ge 2 ]] || usage; act "$2" ;;
    *)    usage ;;
esac
