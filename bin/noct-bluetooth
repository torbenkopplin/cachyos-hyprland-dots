#!/usr/bin/env bash
# noct-bluetooth -- Bluetooth device picker for the Noctalia launcher.
#
#   noct-bluetooth list             emit launcher candidates
#   noct-bluetooth act "<line>"     connect / disconnect / power / scan
#
# Titles say what activating will DO, not what the device currently is: a
# connected device offers "Disconnect", a known one offers "Connect". You read
# the verb, you press Enter, you get that.

set -uo pipefail

. "$(dirname "$(readlink -f "$0")")/noct-common.sh"

usage() { echo "usage: $0 list | $0 act <line>" >&2; exit 2; }

# ---------------------------------------------------------------------------

list() {
    provider bluetooth
    begin_list
    need bluetoothctl || return 0

    local powered connected
    powered=$(bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2; exit}')

    if [[ $powered != yes ]]; then
        item "Turn Bluetooth on" "the adapter is powered off" "power:on"
        item "Scan for devices"  "powers the adapter on first" "scan:"
        return 0
    fi

    # MACs of everything currently connected, one per line.
    connected=$(bluetoothctl devices Connected 2>/dev/null | awk '{print $2}')

    # `bluetoothctl devices` prints: Device <MAC> <name with spaces>
    #
    # The subtitle says what the device IS to you, not what it is to the
    # adapter: the MAC used to go here, and it is both unreadable and the one
    # thing the side map exists to keep out of the visible line. A device with
    # no name falls back to it, because then there is nothing else to show.
    # Two devices with the same name stay distinct through item()'s " (2)".
    while read -r _ mac name; do
        [[ -z ${mac:-} ]] && continue

        if [[ -z ${name:-} ]]; then
            name=$mac
        fi

        if grep -qxF "$mac" <<<"$connected"; then
            item "● Disconnect  $name" "connected" "disconnect:$mac"
        else
            item "Connect  $name" "paired" "connect:$mac"
        fi
    done < <(bluetoothctl devices 2>/dev/null)

    item "Scan for devices"   "10s discovery, then reopens this list" "scan:"
    item "Turn Bluetooth off" "" "power:off"
}

# ---------------------------------------------------------------------------

act() {
    provider bluetooth

    local data action arg
    data=$(payload "$1")
    [[ -z $data ]] && exit 0

    action=${data%%:*}
    arg=${data#*:}

    case "$action" in
        connect)
            # Trusting means it reconnects on its own next time.
            bluetoothctl trust "$arg" >/dev/null 2>&1
            if bluetoothctl connect "$arg" >/dev/null 2>&1; then
                notify-send -a Bluetooth "Connected" "$arg" 2>/dev/null
            else
                notify-send -a Bluetooth -u critical "Could not connect" "$arg" 2>/dev/null
            fi
            ;;
        disconnect)
            bluetoothctl disconnect "$arg" >/dev/null 2>&1
            notify-send -a Bluetooth "Disconnected" "$arg" 2>/dev/null
            ;;
        power)
            if [[ $arg == on ]]; then
                noctalia msg bluetooth-enable >/dev/null 2>&1
            else
                noctalia msg bluetooth-disable >/dev/null 2>&1
            fi
            ;;
        scan)
            # Discovery has to run a while before anything appears, so scan
            # first, then reopen the launcher on this provider.
            noctalia msg bluetooth-enable >/dev/null 2>&1
            bluetoothctl --timeout 10 scan on >/dev/null 2>&1
            noctalia msg panel-toggle launcher "/bt " >/dev/null 2>&1
            ;;
    esac
}

# ---------------------------------------------------------------------------

case "${1:-}" in
    list) list ;;
    act)  [[ $# -ge 2 ]] || usage; act "$2" ;;
    *)    usage ;;
esac
