#!/usr/bin/env bash
# noct-glass -- frosted glass, applied per colour scheme.
#
#   noct-glass apply          work out the level for the active scheme, apply it
#   noct-glass set <0.0-1.0>  override until the next scheme change
#   noct-glass cycle          step through opaque / light / full glass
#   noct-glass show           print the level currently in effect
#
# `apply` is wired to Noctalia's colors_changed hook in 50-glass.toml, so
# switching scheme from /theme (or from the settings GUI, or from IPC) lands
# the matching glass level without anything else being involved.
#
# What "frosted glass" actually is here
# -------------------------------------
# The compositor blurs whatever is behind a window. That only shows if the
# window itself draws a translucent background. So the level below is applied
# to kitty's `background_opacity`, and Hyprland is left rendering windows at
# full opacity -- lowering *its* opacity would fade the text along with the
# background, which is unreadable for work.
#
# That is also why "every app possible" is a short list: GTK and Qt apps paint
# an opaque background and offer no way to ask them not to. Adding them to
# WINDOW_GLASS in conf/rules.lua fades their text too; it is offered as an
# opt-in there, not done by default.

set -uo pipefail

# Every number this script writes is parsed by Lua or by kitty, both of which
# require a '.' decimal separator. awk formats and compares numbers according
# to the locale, so under a sv_SE/de_DE session it would emit "0,90" and
# Hyprland would refuse to load the generated config. Pin the locale.
export LC_ALL=C

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}

LEVELS_FILE="$CONFIG_HOME/noctalia/glass.conf"
OVERRIDE_FILE="$STATE_HOME/noctalia/glass-override"

KITTY_OUT="$CONFIG_HOME/kitty/generated-glass.conf"
HYPR_OUT="$CONFIG_HOME/hypr/generated/glass.lua"

CYCLE_STEPS=(1.00 0.90 0.82 0.70)

usage() { sed -n '3,8p' "$0" | sed 's/^# \?//'; exit 2; }

# ---------------------------------------------------------------------------
# Working out the level
# ---------------------------------------------------------------------------

# Read "key = value" out of glass.conf, ignoring comments and whitespace.
read_level() {
    local key=$1
    [[ -f $LEVELS_FILE ]] || return 1
    awk -F= -v k="$key" '
        /^[[:space:]]*#/ { next }
        {
            gsub(/[[:space:]]/, "", $1)
            gsub(/[[:space:]]/, "", $2)
            if ($1 == k && $2 != "") { print $2; found = 1; exit }
        }
        END { if (!found) exit 1 }
    ' "$LEVELS_FILE"
}

current_scheme() {
    # "wallpaper m3-content" -> "wallpaper:m3-content"
    local s
    s=$(noctalia msg color-scheme-get 2>/dev/null) || return 1
    [[ -z $s ]] && return 1
    printf '%s:%s' "${s%% *}" "${s#* }"
}

# A manual override wins until the scheme changes, which is what makes `cycle`
# feel immediate without permanently editing the per-scheme table.
effective_level() {
    if [[ -f $OVERRIDE_FILE ]]; then
        cat "$OVERRIDE_FILE"
        return 0
    fi

    local scheme
    if scheme=$(current_scheme); then
        read_level "$scheme" && return 0
    fi

    read_level default || printf '0.82'
}

# ---------------------------------------------------------------------------
# Applying it
# ---------------------------------------------------------------------------

write_kitty() {
    local level=$1
    mkdir -p "$(dirname "$KITTY_OUT")"
    cat >"$KITTY_OUT" <<EOF
# Generated by noct-glass. Do not edit -- see ~/.config/noctalia/glass.conf.
background_opacity $level
EOF
}

write_hypr() {
    local level=$1

    # Blur costs GPU time proportional to passes x size. Two passes is the
    # point where it reads as frosted rather than merely soft; more is mostly
    # heat. Skip it entirely when nothing is translucent.
    local blur_enabled="true"
    awk -v l="$level" 'BEGIN { exit !(l >= 0.995) }' && blur_enabled="false"

    mkdir -p "$(dirname "$HYPR_OUT")"
    cat >"$HYPR_OUT" <<EOF
-- Generated by noct-glass from the active colour scheme. Do not edit;
-- change the levels in ~/.config/noctalia/glass.conf instead.
--
-- Windows stay at full opacity on purpose: the translucency comes from the
-- app (kitty's background_opacity), so text stays crisp while the background
-- is blurred. Only unfocused windows are dimmed, as a focus cue.

hl.config({
    decoration = {
        active_opacity   = 1.0,
        inactive_opacity = $(awk -v l="$level" 'BEGIN { printf "%.2f", (l >= 0.995 ? 0.94 : 0.90) }'),

        blur = {
            enabled = $blur_enabled,
            size    = 6,
            passes  = 2,

            -- Sample the wallpaper rather than the windows underneath, so a
            -- busy window behind the terminal does not show through as noise.
            xray    = true,

            -- Slight darkening keeps light text legible over a bright
            -- wallpaper without needing more opacity.
            brightness = 0.85,
            contrast   = 1.0,
            noise      = 0.01,
            vibrancy   = 0.17,

            popups          = true,
            popups_ignorealpha = 0.4,
            new_optimizations  = true,
        },
    },
})
EOF
}

apply() {
    local level
    level=$(effective_level)

    write_kitty "$level"
    write_hypr "$level"

    # Hyprland reloads on config change, but generated/glass.lua is reached
    # through a require() and we do not rely on those being watched.
    command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1

    # kitty applies background_opacity at startup, so open windows keep the
    # old level. Colours, by contrast, repaint live through the OSC template.
    printf '%s\n' "$level"
}

# ---------------------------------------------------------------------------

case "${1:-apply}" in
    apply)
        rm -f "$OVERRIDE_FILE"
        apply >/dev/null
        ;;
    set)
        [[ $# -ge 2 ]] || usage
        mkdir -p "$(dirname "$OVERRIDE_FILE")"
        printf '%s' "$2" >"$OVERRIDE_FILE"
        apply >/dev/null
        ;;
    cycle)
        current=$(effective_level)
        next=${CYCLE_STEPS[0]}
        for i in "${!CYCLE_STEPS[@]}"; do
            if [[ ${CYCLE_STEPS[$i]} == "$current" ]]; then
                next=${CYCLE_STEPS[$(( (i + 1) % ${#CYCLE_STEPS[@]} ))]}
                break
            fi
        done
        mkdir -p "$(dirname "$OVERRIDE_FILE")"
        printf '%s' "$next" >"$OVERRIDE_FILE"
        apply >/dev/null
        notify-send -a Glass "Frosted glass" "opacity $next (new terminals)" 2>/dev/null
        ;;
    show)
        effective_level; echo
        ;;
    *) usage ;;
esac
