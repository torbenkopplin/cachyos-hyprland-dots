#!/usr/bin/env bash
# noct-glass -- frosted glass, applied per colour scheme.
#
#   noct-glass apply           work out the levels for the active scheme, apply
#   noct-glass set <0.0-1.0>   override the window level until the next change
#   noct-glass cycle           step through opaque / light / default / heavy
#   noct-glass show            print the levels currently in effect, and which
#                              file they came from
#
# `apply` is wired to Noctalia's colors_changed hook in 50-glass.toml, so
# switching scheme from /theme (or the settings GUI, or IPC) lands the matching
# glass level without anything else being involved.
#
# How the effect is built
# -----------------------
# Hyprland blurs whatever is behind a window wherever that window is not fully
# opaque. Two levels feed that, and both are stated as what you actually see:
#
#   window    -> decoration.active_opacity / inactive_opacity, i.e. EVERY
#                window. The compositor cannot separate a window's text from its
#                background, so this fades both. Shipped at 1.0 since
#                2026-08-19: no compositor transparency at all.
#
#   terminal  -> how opaque a *terminal* ends up. kitty is the only window here
#                that can be translucent on its own, and the only one that fades
#                its background WITHOUT fading its text. Shipped at 0.55, and
#                the whole of the effect now.
#
# So the value written for the terminal is not the level itself, it is
# terminal / window: the compositor is already applying `window` to that surface,
# and this is the factor that turns it into the level you asked for. At
# window = 1.0 that division is by one, so `terminal` reaches kitty untouched.
#
# Why it is that way round: every step of glassiness taken through `window`
# costs contrast, and every step taken through `terminal` costs none. Glass on
# a GTK or Qt app can only be bought by fading its text, and that was not worth
# it on a machine you work on -- so those apps are opaque, on purpose, and the
# terminal keeps the effect. Measured, and the reasoning is in glass.conf.
#
# A browser is not a special case. It gets `window`, like every other app that
# paints its own background. There was a third level here that tinted Zen's page
# area for the transparency mod; it was given up on 2026-08-19 and the reasoning
# is in docs/theming.md.
#
# Two files, and the second one is not in the repo: glass.conf is tracked and
# applies everywhere, glass.local.conf is this machine's own and wins. Set
# `terminal = 1.0` there for a desktop with no translucency anywhere at all.

set -uo pipefail

# noct_scheme() reads the active palette out of Noctalia's own state files
# rather than asking the running shell over IPC. This script is called from the
# colors_changed hook, i.e. from inside Noctalia, and a config reader that
# cannot deadlock against its own caller is worth more here than the two lines
# it saves. Same reader the launcher providers use.
. "$(dirname "$(readlink -f "$0")")/noct-common.sh"

# Every number this script writes is parsed by Lua or by kitty, both of which
# require a '.' decimal separator. awk formats and compares numbers according
# to the locale, so under a sv_SE session it would emit "0,90" and Hyprland
# would refuse to load the generated config. Pin the locale.
export LC_ALL=C

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}

LEVELS_FILE="$CONFIG_HOME/noctalia/glass.conf"

# This machine's own answer, and it is not in the repo. glass.conf is tracked,
# so a level set there is a level set on every machine that pulls -- and the
# right level is not a property of the setup, it is a property of the screen in
# front of you. Same arrangement as ~/.config/hypr/host.lua: untracked, absent
# by default, and read after the tracked file so it wins. See
# glass.local.conf.example.
LOCAL_FILE="$CONFIG_HOME/noctalia/glass.local.conf"

OVERRIDE_FILE="$STATE_HOME/noctalia/glass-override"

KITTY_OUT="$CONFIG_HOME/kitty/generated-glass.conf"
HYPR_OUT="$CONFIG_HOME/hypr/generated/glass.lua"

# opaque -> light -> default -> heavy, and the middle two have to bracket the
# level in glass.conf or the cycle is useless: `cycle` looks the current level
# up in this list and takes the next one, so a list that does not contain it
# restarts at the top. When these were 1.00/0.95/0.90/0.82 and the default
# dropped to 0.60, one press jumped straight to fully opaque.
CYCLE_STEPS=(1.00 0.75 0.60 0.50)

# Found by shape rather than by line number, so adding a line to the block
# above cannot silently truncate the usage text -- which it just did. Same
# approach as install.sh --help.
usage() {
    awk 'NR < 3 { next }
         /^#[[:space:]]*$/ { if (seen) exit; next }
         { sub(/^# ?/, ""); print; seen = 1 }' "$0"
    exit 2
}

# ---------------------------------------------------------------------------
# Reading the levels
# ---------------------------------------------------------------------------

# read_from <file> <key> -- "key = value", comments and spaces ignored.
read_from() {
    local file=$1 key=$2
    [[ -f $file ]] || return 1
    awk -F= -v k="$key" '
        /^[[:space:]]*#/ { next }
        {
            gsub(/[[:space:]]/, "", $1)
            gsub(/[[:space:]]/, "", $2)
            if ($1 == k && $2 != "") { print $2; found = 1; exit }
        }
        END { if (!found) exit 1 }
    ' "$file"
}

current_scheme() {
    local s
    s=$(noct_scheme 2>/dev/null) || return 1
    [[ -z $s ]] && return 1
    printf '%s:%s' "${s%% *}" "${s#* }"   # "custom noirblaze" -> "custom:noirblaze"
}

# setting <key> <fallback> -- per-scheme override, else the bare key, else the
# built-in, and the machine's own file before either of those. Every knob
# resolves through here, so a scheme can override the blur the same way it
# overrides the levels: `builtin:Catppuccin.blur_brightness = 0.8` is read
# before the bare `blur_brightness`.
#
# Note the order. BOTH of the local file's keys are read before EITHER of the
# tracked file's, rather than interleaving them per key. Otherwise a tracked
# per-scheme line would beat a bare `window` set locally, and a machine that had
# said "no compositor transparency here" would get it back the moment you
# switched to the one scheme that overrides it -- which is the failure this file
# exists to prevent.
setting() {
    local what=$1 fallback=$2 scheme file
    scheme=$(current_scheme) || scheme=

    for file in "$LOCAL_FILE" "$LEVELS_FILE"; do
        [[ -f $file ]] || continue
        [[ -n $scheme ]] && read_from "$file" "$scheme.$what" && return 0
        read_from "$file" "$what" && return 0
    done
    printf '%s' "$fallback"
}

# level <window|terminal> -- the visible opacity of a surface.
#
# The fallbacks are the two shipped defaults rather than one number for both:
# with no glass.conf at all you get an opaque desktop and a translucent
# terminal, which is what this setup is, instead of a uniform level nobody
# chose.
level() {
    case $1 in
        window)   setting window   1.0  ;;
        terminal) setting terminal  0.55 ;;
        *)        setting "$1"      1.0  ;;
    esac
}

window_level() {
    # A manual override wins until the scheme changes, which is what makes
    # `cycle` feel immediate without editing the per-scheme table.
    [[ -f $OVERRIDE_FILE ]] && { cat "$OVERRIDE_FILE"; return 0; }
    level window
}

# ---------------------------------------------------------------------------
# Applying
# ---------------------------------------------------------------------------

# write_kitty <window level> <terminal level>
#
# kitty's own opacity multiplies with the compositor's, so the value written
# here is the factor that takes `window` to `terminal` -- 1.0 when they are
# equal, in which case a terminal and any other window side by side show the
# wallpaper through them to exactly the same degree.
write_kitty() {
    local factor
    factor=$(awk -v t="$1" -v w="$2" 'BEGIN {
        if (w < 0.05) w = 0.05          # never divide by a fully invisible window
        f = t / w
        if (f > 1) f = 1                # kitty cannot be *more* opaque than opaque
        if (f < 0) f = 0
        printf "%.2f", f
    }')

    mkdir -p "$(dirname "$KITTY_OUT")"
    cat >"$KITTY_OUT" <<EOF
# Generated by noct-glass. Do not edit -- see ~/.config/noctalia/glass.conf.
#
# terminal $1 / window $2: the compositor already fades this window to $2, so
# kitty only supplies what is left over to reach $1.
background_opacity $factor
EOF
}

# write_hypr <window level> <terminal level>
write_hypr() {
    local win=$1 term=$2

    # Blur costs GPU time proportional to passes x size, and there is nothing
    # behind an opaque surface to blur. But `window` at 1.0 does NOT mean
    # nothing is translucent: kitty draws its own background at `terminal`, and
    # the blur behind that is now the whole of the frosted effect, since the
    # compositor supplies none. So both levels decide this. Deciding it on
    # `window` alone left a translucent terminal sitting over a sharp,
    # unblurred wallpaper -- transparency without the frost.
    local blur_enabled="true"
    awk -v w="$win" -v t="$term" 'BEGIN { exit !(w >= 0.995 && t >= 0.995) }' && blur_enabled="false"

    # Unfocused windows sit one step further back -- but only while focused
    # ones are translucent at all. At window = 1.0 the compositor fades
    # nothing, and dimming the unfocused ones would put back exactly what that
    # setting is there to remove, text included. The focus cue is then the
    # border: a gradient on the focused window, a hairline on everything else
    # (conf/look.lua).
    #
    # When it does apply, the floor is 0.50 rather than 0.60 because the levels
    # moved once already: at window = 0.60 a 0.60 floor made active and
    # inactive the same number and the focus cue disappeared silently. 0.50
    # still leaves an inactive terminal legible -- its text composites at about
    # 130 of 255 against a backdrop in the 60s.
    local inactive=$win
    if awk -v l="$win" 'BEGIN { exit !(l < 0.995) }'; then
        inactive=$(awk -v l="$win" 'BEGIN { v = l - 0.06; if (v < 0.50) v = 0.50; printf "%.2f", v }')
    fi

    # The blur is what the wallpaper looks like by the time it reaches the back
    # of a window, so it is half of the frosted effect and it belongs in
    # glass.conf next to the other half. See the note there for what each knob
    # costs; `noct-check glass-visible` measures the result.
    local b_size b_passes b_bright b_contrast b_vibrancy
    b_size=$(setting blur_size 8)
    b_passes=$(setting blur_passes 3)
    b_bright=$(setting blur_brightness 0.95)
    b_contrast=$(setting blur_contrast 1.0)
    b_vibrancy=$(setting blur_vibrancy 0.15)
    local b_xray; b_xray=$(setting blur_xray false)

    mkdir -p "$(dirname "$HYPR_OUT")"
    cat >"$HYPR_OUT" <<EOF
-- Generated by noct-glass from the active colour scheme. Do not edit;
-- change the levels in ~/.config/noctalia/glass.conf instead, or in
-- glass.local.conf for this machine only.
--
-- active/inactive_opacity apply to EVERY window, text included: the compositor
-- cannot tell a window's glyphs from its background. At 1.0 -- the shipped
-- default -- it fades nothing, and the only surface this script makes translucent
-- is kitty, which draws its own background at \`terminal\` and leaves its text
-- alone. The blur below is therefore what a terminal is looking through, and it
-- stays on for exactly that reason. Zen is translucent as well, from its own mod
-- rather than from anything here, and it gets the same blur behind it.

hl.config({
    decoration = {
        active_opacity   = $win,
        inactive_opacity = $inactive,

        blur = {
            enabled = $blur_enabled,

            -- What you see through a window is
            --
            --   (backdrop - the window's own colour) x (1 - opacity)
            --
            -- so these knobs and the levels multiply. \`size\` and \`passes\` decide
            -- whether the wallpaper arrives as shape or as a flat wash --
            -- everything above roughly size 16 averages the image away and the
            -- window reads as paint, whatever its opacity. \`brightness\` scales the
            -- backdrop directly: at 0.65 a wallpaper of mean luma 99 arrives at
            -- about 57, which against a near-black window leaves almost nothing
            -- to see.
            size    = $b_size,
            passes  = $b_passes,

            -- Blur behind a window at full strength regardless of how
            -- translucent that window is; without it a 0.9 window gets only a
            -- tenth of the blur and the effect disappears.
            ignore_opacity = true,

            -- Off: a window samples whatever is actually beneath it. For a
            -- tiled window that IS the wallpaper -- columns do not overlap --
            -- so this changes nothing there. For a floating window it is the
            -- window underneath, and the translucency compounds the way
            -- stacked glass does. Darker than a tiled window at the same
            -- level, which is what being in front should look like.
            xray = $b_xray,

            brightness = $b_bright,
            contrast   = $b_contrast,
            noise      = 0.01,
            vibrancy   = $b_vibrancy,

            popups             = true,
            popups_ignorealpha = 0.4,
            new_optimizations  = true,
        },
    },
})
EOF
}

# levels -- "<window> <terminal>", and nothing else. Reading the configuration
# must not have side effects: `show` used to call apply(), so asking what the
# levels were rewrote the generated files, reloaded Hyprland and signalled every
# kitty. A check that has to disturb the thing it measures is not a check.
levels() {
    local win term
    win=$(window_level)
    term=$(level terminal)

    # SUPER+SHIFT+G is "make the desktop more or less glassy", not "make
    # everything except the terminal more or less glassy" -- so while a manual
    # override is in effect the terminal tracks it too. Without this, stepping to
    # fully opaque would leave translucent windows on screen.
    [[ -f $OVERRIDE_FILE ]] && term=$win

    printf '%s %s' "$win" "$term"
}

apply() {
    local win term
    read -r win term <<<"$(levels)"

    write_kitty "$term" "$win"
    write_hypr "$win" "$term"

    # Hyprland reloads on config change, but generated/glass.lua is reached
    # through a require() and we do not rely on those being watched.
    command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1

    # kitty re-reads its COLOURS on SIGUSR1, which is what makes a scheme change
    # land in terminals you already have open. It does not re-read
    # background_opacity: measured 2026-08-18, a running kitty stayed at the
    # opacity it started with while generated-glass.conf said otherwise. That is
    # why glass.conf keeps `terminal` equal to `window` -- a terminal-specific
    # level would otherwise leave you with two shades of terminal until every one
    # of them had been restarted.
    pkill -USR1 -x kitty >/dev/null 2>&1

    printf 'window %s  terminal %s\n' "$win" "$term"
}

# ---------------------------------------------------------------------------

case "${1:-apply}" in
    apply)
        rm -f "$OVERRIDE_FILE"
        apply >/dev/null
        ;;
    set)
        [[ $# -ge 2 ]] || usage
        mkdir -p "$(dirname "$OVERRIDE_FILE")"
        printf '%s' "$2" >"$OVERRIDE_FILE"
        apply >/dev/null
        ;;
    cycle)
        current=$(window_level)
        next=${CYCLE_STEPS[0]}
        # Compared as a NUMBER, not as a string. The steps are written to two
        # decimals and glass.conf is written the way a person writes a level, so
        # "1.00" and "1.0" are the same level and were not the same string: at
        # the shipped window = 1.0 the first press matched nothing, restarted the
        # cycle at 1.00, and looked like the bind had done nothing.
        for i in "${!CYCLE_STEPS[@]}"; do
            if awk -v a="${CYCLE_STEPS[$i]}" -v b="$current" \
                   'BEGIN { d = a - b; if (d < 0) d = -d; exit !(d < 0.005) }'; then
                next=${CYCLE_STEPS[$(( (i + 1) % ${#CYCLE_STEPS[@]} ))]}
                break
            fi
        done
        mkdir -p "$(dirname "$OVERRIDE_FILE")"
        printf '%s' "$next" >"$OVERRIDE_FILE"
        apply >/dev/null
        notify-send -a Glass "Frosted glass" "window opacity $next" 2>/dev/null
        ;;
    show)
        # Read-only on purpose -- see levels().
        #
        # The trailing marker is appended, never inserted: `noct-check` reads
        # the second and fourth fields of this line, so the numbers have to stay
        # where they are. It is here because "this machine is different" is
        # exactly the thing you want to be told when the two machines disagree
        # and you are looking for which file said so.
        marker=""
        [[ -f $OVERRIDE_FILE ]] && marker="  [override: SUPER+SHIFT+G]"
        [[ -z $marker && -f $LOCAL_FILE ]] && marker="  [glass.local.conf]"
        # Deliberately unquoted: levels() prints the two numbers separated by a
        # space, and they are two arguments here.
        # shellcheck disable=SC2046,SC2183
        printf 'window %s  terminal %s%s\n' $(levels) "$marker"
        ;;
    *) usage ;;
esac
