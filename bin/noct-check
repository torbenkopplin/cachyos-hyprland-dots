#!/usr/bin/env bash
# noct-check -- the runner for this repo's test suite.
#
#   noct-check                    run every check that does not disturb the screen
#   noct-check --all              also run the ones that open windows
#   noct-check --list             print the checks, with what each one asserts
#   noct-check <name> [...]       run only these, live or not
#   noct-check --json             results and measurements as JSON, nothing else
#   noct-check --record [file]    run, then save the measurements as a baseline
#   noct-check --compare <file>   run, then say which measurements have moved
#
# Exit status is 0 only if every check that ran passed, and every comparison
# was within tolerance.
#
# What this suite is for
# ----------------------
# TESTING.md is a checklist for things only a person can judge -- does the
# animation feel right, did the prompt window appear. Everything here is the
# opposite: a fact about the running session that is easy to measure and easy
# to be wrong about by eye.
#
# Every check corresponds to something that was actually broken and was NOT
# obvious from looking at the screen:
#
#   session-path     the launcher providers all returned "No results found",
#                    which is also exactly what a working provider with nothing
#                    to report looks like.
#   provider-run     a provider that dies still shows an empty list.
#   glass-live       the config on disk and the running session disagreed for an
#                    entire session without anything saying so.
#   glass-visible    the frosted glass was mathematically present and visually
#                    absent -- 7 levels of 255.
#   keyword-inert    `hyprctl keyword` is silently a no-op under the Lua parser,
#                    so an A/B test written with it measures nothing and reports
#                    success.
#   deps-manifest    tree-sitter-cli was never in install.sh, on a machine that
#                    already had it installed by hand.
#   browser-glass    three of the four browsers cannot be translucent by
#                    themselves, so they sit at a level nobody chose for them.
#
# Two things it does that a checklist cannot
# ------------------------------------------
# It always opens NEW windows to measure. A terminal you already had open is
# running the config as it was when you opened it, and a browser is running the
# stylesheet as it was when you launched it. See tests/lib/probe.sh.
#
# It records the numbers, not just the verdicts. "Both machines pass and one of
# them looks better" is not a question a threshold can answer, so --record and
# --compare answer it by diffing the measurements. See tests/lib/baseline.sh.
#
# The framework is in tests/. Adding a check means one function and one
# noct_register line; tests/README.md is the short version.

set -uo pipefail
export LC_ALL=C

# Resolved through the symlink, because install.sh puts this on PATH as a link
# into the repo and the whole framework lives beside it.
NOCT_BIN=$(dirname "$(readlink -f "$0")")
NOCT_REPO=$(dirname "$NOCT_BIN")
NOCT_TESTS=$NOCT_REPO/tests

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
BIN_HOME=${BIN_HOME:-$HOME/.local/bin}
NOCT_GLASS=$NOCT_BIN/noct-glass
NOCT_HOST=${NOCT_HOST:-$(hostname 2>/dev/null || echo unknown)}

if [[ ! -d $NOCT_TESTS ]]; then
    printf 'noct-check: no tests/ beside %s\n' "$NOCT_BIN" >&2
    printf 'This has to be run from a checkout of the repo, or through the symlink\n' >&2
    printf 'install.sh puts in %s -- a copied file has no framework to load.\n' "$BIN_HOME" >&2
    exit 2
fi

# shellcheck source=/dev/null
for lib in harness measure probe baseline; do source "$NOCT_TESTS/lib/$lib.sh"; done
# shellcheck source=/dev/null
for f in "$NOCT_TESTS"/checks/*.sh; do source "$f"; done

usage() { sed -n '3,10p' "$0" | sed 's/^# \?//'; exit 2; }

# Any probe window left over from a run that died. Matched on the classes this
# suite spawns under and nothing else, so a window of yours is never at risk.
noct_sweep_probes() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    command -v jq      >/dev/null 2>&1 || return 0
    local addr
    while read -r addr; do
        [[ -n $addr ]] || continue
        hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null 2>&1
    done < <(hyprctl -j clients 2>/dev/null \
             | jq -r '.[] | select(.class | startswith("noct-probe")) | .address')
    return 0
}

list_checks() {
    local name
    printf '%spure -- safe to run any time%s\n' "$BOLD" "$RESET"
    for name in $(noct_checks_of_class pure); do
        printf '  %-18s %s\n' "$name" "${NOCT_CHECK_DESC[$name]}"
    done
    printf '\n%slive -- opens windows and briefly changes the screen%s\n' "$BOLD" "$RESET"
    for name in $(noct_checks_of_class live); do
        printf '  %-18s %s\n' "$name" "${NOCT_CHECK_DESC[$name]}"
    done
}

main() {
    local -a to_run=()
    local mode=default baseline_file=

    while (( $# )); do
        case $1 in
            --list)    list_checks; exit 0 ;;
            --all)     mapfile -t to_run < <(noct_checks_of_class all); shift ;;
            --json)    QUIET=1; mode=json; shift ;;
            --record)  mode=record
                       # An optional path: anything that is not another flag.
                       if [[ ${2-} && ${2-} != -* ]]; then baseline_file=$2; shift; fi
                       shift ;;
            --compare) mode=compare; baseline_file=${2-}; shift 2 || shift ;;
            -h|--help) usage ;;
            -*)        printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
            *)         to_run+=("$1"); shift ;;
        esac
    done

    # Recording or comparing a partial run would produce a baseline with holes
    # in it, which is worse than no baseline: the missing metrics read as "not
    # comparable" forever after, on every machine.
    if [[ $mode == record || $mode == compare ]] && (( ${#to_run[@]} == 0 )); then
        mapfile -t to_run < <(noct_checks_of_class all)
    fi
    (( ${#to_run[@]} )) || mapfile -t to_run < <(noct_checks_of_class pure)

    # The only signal trap in the suite. Everything a check needs to put back
    # is on the defer stack, so this is all it takes to leave the desktop as it
    # was when the run is interrupted half way through a measurement.
    trap 'noct_unwind; noct_sweep_probes; exit 130' INT TERM

    # A belt as well as braces. The defer stack is the mechanism, and it is
    # correct, but a probe window that outlives its run is uniquely nasty: it
    # takes a column of the tape, which narrows the next probe, which then has
    # too little of itself on screen to measure -- so the suite goes quiet
    # rather than red, and the reason is a window from an hour ago. Cheap to
    # rule out, so it is ruled out on the way in and on the way out.
    noct_sweep_probes
    trap noct_sweep_probes EXIT

    local c
    for c in "${to_run[@]}"; do noct_run_check "$c" || FAIL=$((FAIL + 1)); done

    case $mode in
        json)
            noct_json
            ;;
        record)
            noct_summary
            noct_baseline_record "${baseline_file:-$(noct_baseline_default_path)}"
            ;;
        compare)
            noct_summary
            [[ -n $baseline_file ]] || { printf '\n--compare needs a baseline file\n' >&2; exit 2; }
            noct_baseline_report "$baseline_file"
            ;;
        *)
            noct_summary
            ;;
    esac

    (( FAIL == 0 && NOCT_BASELINE_FAIL == 0 ))
}

main "$@"
